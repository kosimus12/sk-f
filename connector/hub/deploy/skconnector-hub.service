[Unit]
Description=SK Connector Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=skconnector
Group=skconnector
WorkingDirectory=/opt/skconnector
Environment=CONNECTOR_DB=/var/lib/skconnector/hub.db
Environment=CONNECTOR_RETENTION_DAYS=30
# Standard: nur lokal erreichbar. Laeuft der Reverse-Proxy in einem
# Docker-Container, muss der Hub zusaetzlich auf dem Bridge-Gateway
# lauschen (meist 172.17.0.1) - sonst kommt der Container nicht heran.
# Dann in /etc/skconnector/hub.env setzen:  CONNECTOR_BIND=172.17.0.1
Environment=CONNECTOR_BIND=127.0.0.1
Environment=CONNECTOR_PORT=8787
# Wie lange eine Freischaltung mit dem Authenticator-Code gilt.
Environment=CONNECTOR_UNLOCK_SECONDS=900
EnvironmentFile=/etc/skconnector/hub.env
ExecStart=/opt/skconnector/venv/bin/uvicorn hub.app:app --host ${CONNECTOR_BIND} --port ${CONNECTOR_PORT} --timeout-keep-alive 75
Restart=always
RestartSec=3

# Absicherung: der Hub braucht nur seine Datenbank.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skconnector
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
